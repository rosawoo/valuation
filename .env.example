# Copy to ".env" at the repo root (or export in your shell).
# Quick local stack: from repo root run `pnpm install` then `pnpm dev` (API on :3001 + Vite on :5173 with /api proxy).

# Required for the API (@workspace/db). Optional in .env.local for overrides.
# Railway (local dev on your machine): paste the *public* Postgres URL here (e.g. DATABASE_PUBLIC_URL).
# The default DATABASE_URL from Railway often uses host *.railway.internal and only works inside Railway.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/valyoued

# API HTTP port: defaults to 3001 if unset (matches Vite's /api dev proxy).


# --- Web (Vite / Vercel) ---
# Production canonical / Open Graph base URL for SEO (no trailing slash). Optional; defaults to runtime origin then https://www.valyoued.ai.
# VITE_PUBLIC_SITE_ORIGIN=https://www.valyoued.ai
# Required for real Clerk. Root `.env.development` sets stub auth for local `vite`; without env files,
# Vite still enables stub in development when no publishable key (use VITE_AUTH_STUB_MODE=0 to opt out).
VITE_CLERK_PUBLISHABLE_KEY=

# Local dev: Vite proxies /api → this URL when VITE_API_ORIGIN is unset (Express default below).
# VITE_DEV_API_PROXY=http://127.0.0.1:3001


# When API is NOT same-origin as the UI (typical: Vercel frontend + Railway/Fly/Render API):
# Set on Vercel (Environment Variables). Full URL recommended; host-only (`*.up.railway.app`) gets `https://` prepended in the app and in vercel.mjs.
# VITE_API_ORIGIN=https://your-api.example.com

# For local Vite (`pnpm dev`): if root `.env` sets VITE_API_ORIGIN to Railway or Vercel production, the dev
# Subscription strip still sends `X-Stub-Billing-Plan` but a **production** API ignores it, so trading desks
# return 403 ("Professional subscription"). Fix: use same-origin `/api` against local Express. Either unset
# `VITE_API_ORIGIN` for development, or add `.env.development.local` with `VITE_API_ORIGIN=` (empty) so it
# overrides `.env` during Vite dev only. Point at `http://127.0.0.1:3001` instead if you insist on an absolute origin.

# Optional Clerk Frontend API proxy (Replit / same-origin Railway). Must start with `/` plus path or http(s).
# Leave unset for normal setups: Clerk scripts load from your Frontend API (*.clerk.accounts.dev).
# Clerk builds clerk-js URLs as `https://{scriptHost}/npm/@clerk/...` using your proxy URL with the scheme removed.
# An origin-only value (`https://…up.railway.app`) makes the browser fetch `/npm/…` from your root (404 and HTML MIME errors).
# Prefer `https://…up.railway.app` (bare origin, we append `/api/__clerk`), full `…/api/__clerk`, or relative `/api/__clerk`.
# Strip accidental shell quotes Railway may store around the variable value.
# The API needs CLERK_SECRET_KEY in production or `/api/__clerk` stays disabled (`clerkProxyMiddleware` warns in logs once).
# VITE_CLERK_PROXY_URL=

# --- API server (Express, artifacts/api-server) ---
# Container image (Railway / Fly / any Docker host): `docker build -t valyoued-api .` from repo root; see railway.toml.
#
# IMPORTANT: The API must have Clerk keys in **its own** environment (Railway vars, etc.).
# Variables you set only on Vercel are never sent to the API container: copy them here too.

# Must match the Clerk app used by VITE_CLERK_PUBLISHABLE_KEY:
# CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Admin dashboard (/api/admin/*). Comma-separated Clerk user IDs (`user_...` from Clerk Dashboard → Users).
# With AUTH_STUB_MODE=1 locally, admins are allowed even if this is unset. In production always set this explicitly.
# ADMIN_USER_IDS=user_2abc...,user_2def...

# --- LLM (`@workspace/llm`): provider-agnostic at the code layer (`getLlm` / `defaultModel`) ---
# Deployments (Railway, Fly, Docker): set variables on the API process that serves `/api`, not only on the static frontend. Without a key, `/api/vision/extract` responds 503 and photo auto-fill is disabled.
# Prefer one of these patterns:
#
# (A) Generic key + explicit provider (works for any supported backend):
# LLM_PROVIDER=openai
# LLM_API_KEY=
# Optional proxy / custom base for the active provider:
# LLM_BASE_URL=
#
# (B) Vendor-native vars (auto-detect provider when LLM_PROVIDER is unset; Anthropic wins if both are set):
# LLM_PROVIDER=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
#
# Optional model id override (examples: claude-sonnet-4-5, gpt-5.5):
# LLM_MODEL=

# Replit Anthropic integration (optional; overrides ANTHROPIC_* when set):
# AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com
# AI_INTEGRATIONS_ANTHROPIC_API_KEY=

# Anthropic-only: base URL defaults to https://api.anthropic.com when unset.
# ANTHROPIC_BASE_URL=
# ANTHROPIC_API_KEY=

# OpenAI-only (or use OPENAI_API_KEY instead of LLM_API_KEY with LLM_PROVIDER=openai):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# --- Local dev stubs (never enable in public production without safeguards) ---
# Auth: skip Clerk on API + treat UI as signed-in (fixed user id on server).
# VITE_AUTH_STUB_MODE=1
# AUTH_STUB_MODE=1
# AUTH_STUB_USER_ID=dev-stub-user
# Optional default tier for AUTH_STUB_MODE=1. During local dev the SPA stub toolbar sends X-Stub-Billing-Plan and overrides env on every request once you pick Free, Everyday, or Professional.
# Accepted: free, everyday_free, none, everyday_plus, plus, pro (legacy Everyday alias), paid, professional, seller.
# AUTH_STUB_BILLING_TIER=free
#
# Real Clerk locally (AUTH_STUB_MODE=0): the API honors X-Stub-Billing-Plan from the SPA dev Subscription strip when NODE_ENV=development (default under `pnpm dev` for api-server) or when this opt-in is set (e.g. you run `node dist/` with NODE_ENV=production locally):
# ALLOW_DEV_STUB_BILLING_HEADERS=1
# Set this to refuse those simulation headers anyway:
# DISABLE_DEV_STUB_BILLING_HEADERS=1

# --- Local entitlement simulation (Stripe Checkout wiring can wait) ---
#
# STRIPE_STUB_PLAN + inheritance (tokens match X-Stub-Billing-Plan: free, everyday_plus, professional, plus, …).
# Trusted when NODE_ENV=development under root `pnpm dev`, or set ALLOW_STRIPE_STUB_ENTITLEMENTS=1 on a private host only.
# Refuse: DISABLE_STRIPE_STUB_ENTITLEMENTS=1
#
# Toggle vs STRIPE_STUB_PLAN (default keeps SPA strip authoritative when dev headers trust):
# - Omit STRIPE_STUB_PLAN for strip-only (X-Stub headers) together with ALLOW_DEV_STUB_BILLING_HEADERS=1 / NODE_ENV=development API.
# - STRIPE_STUB_PLAN_RESOLUTION=toggle_first applies env only when strip headers did not attach for that request.
# - STRIPE_STUB_PLAN_RESOLUTION=env_first locks API entitlements to env whenever STRIPE_STUB_PLAN is active.
# STRIPE_STUB_PLAN=professional
# STRIPE_STUB_PLAN_RESOLUTION=toggle_first
# STRIPE_STUB_INHERITANCE_ADDON=1
# ALLOW_STRIPE_STUB_ENTITLEMENTS=1
#
# --- Stripe (live billing) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_EVERYDAY_PLUS=
# STRIPE_PRICE_PROFESSIONAL=
# STRIPE_PRICE_INHERITANCE_ADDON=
# Webhook endpoint: POST /api/billing/webhook (raw body). Enable at least:
# checkout.session.completed, customer.subscription.updated, customer.subscription.deleted, invoice.upcoming
# Stripe sends invoice.upcoming about 3 days before renewal by default (Dashboard > Settings > Billing > Subscriptions and emails).

# Escape hatch if you truly need stubs with NODE_ENV=production (unsafe):
# ALLOW_INSECURE_DEV_STUBS=1

# --- FX (USD normalization for portfolio + /estimates/stats) ---
# When enabled, the API fetches ECB rates via Frankfurter, merges with static fallbacks for missing currencies, and caches the result.
# FX_LIVE_ENABLED=1
# Optional: override Frankfurter URL (default https://api.frankfurter.app/v1/latest?from=USD)
# FRANKFURTER_URL=
# Cache TTL in ms for live FX (default 6 hours)
# FX_CACHE_TTL_MS=

# Email alerts (Resend). Required for subscription renewal notices and optional portfolio alert toggles.
# Without RESEND_API_KEY + EMAIL_FROM, billing confirmation and pre-renewal emails are not sent.
# Use a verified domain or Resend's onboarding sender in development.
# RESEND_API_KEY=
# EMAIL_FROM="ValYoued <onboarding@resend.dev>"
# Auth stub: inbox for Settings test/sample emails when Clerk is off (or pass "to" in the test POST body).
# STUB_TEST_EMAIL=you@example.com

# Used in billing return URLs and email deep links to the web app. In local API dev (NODE_ENV != production),
# links default to http://localhost:5173 unless PUBLIC_APP_URL points at localhost, 127.0.0.1, or an ngrok host.
# PUBLIC_APP_URL=https://www.valyoued.ai

# --- Market Watch agent (Professional) ---
# Tavily web search for agentic market research snapshots. Without this, Market Watch falls back to illustrative anchors.
# Also used by the valuation pipeline to enrich comparables with web snippets when set.
# TAVILY_API_KEY=
# Total search budget in ms (default 8000).
# MARKET_WATCH_SEARCH_BUDGET_MS=8000
# Max manual refreshes per user per UTC day (default 30).
# MARKET_WATCH_MAX_REFRESHES_PER_DAY=30

# API listen port: optional; the server defaults to 3001 if unset (same as Vite /api proxy target).
# PORT=8080
